{
    "name": "flawless-cut",
    "productName": "Flawless Cut",
    "version": "1.2.0",
    "description": "Fast, lossless video cutter and merger",
    "author": "Marco Chan",
    "repository": "github:metadream/flawless-cut",
    "copyright": "Copyright (c) 2019-2026",
    "license": "MIT",
    "type": "module",
    "main": "src/main/index.js",
    "scripts": {
        "start": "electron .",
        "build:linux": "electron-builder -l",
        "build:win": "electron-builder -w",
        "build:mac": "electron-builder -m"
    },
    "build": {
        "appId": "flawless-cut",
        "files": [
            "**/*",
            "!bin/**/*"
        ],
        "win": {
            "target": [ "nsis" ],
            "extraResources": [
                {
                    "from": "bin/win32",
                    "to": "bin"
                }
            ]
        },
        "linux": {
            "target": [ "deb" ],
            "extraResources": [
                {
                    "from": "bin/linux",
                    "to": "bin"
                }
            ]
        },
        "mac": {
            "target": [ "dmg" ],
            "icon": "assets/build/icon.icns",
            "extraResources": [
                {
                    "from": "bin/darwin",
                    "to": "bin"
                }
            ],
            "category": "public.app-category.productivity"
        }
    },
    "devDependencies": {
        "electron": "^39.2.2",
        "electron-builder": "^26.0.12"
    }
}