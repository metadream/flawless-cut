{
    "name": "flawless-cut",
    "version": "1.1.0",
    "description": "Fast, lossless video cutter and merger",
    "author": "Marco Chan",
    "repository": "github:metadream/flawless-cut",
    "copyright": "Copyright (c) 2019-2026",
    "license": "MIT",
    "type": "module",
    "main": "main.js",
    "scripts": {
        "start": "electron .",
        "build:linux": "electron-builder -l",
        "build:win": "electron-builder -w",
        "build:mac": "electron-builder -m"
    },
    "build": {
        "appId": "flawless-cut",
        "productName": "Flawless Cut",
        "win": {
            "target": [
                "nsis"
            ]
        },
        "linux": {
            "target": [
                "deb"
            ]
        },
        "mac": {
            "target": "dmg",
            "icon": "assets/icons/icon.icns",
            "category": "public.app-category.productivity",
            "extendInfo": {
                "CFBundleDisplayName": "Flawless Cut"
            }
        }
    },
    "devDependencies": {
        "electron": "^39.2.2",
        "electron-builder": "^26.0.12"
    },
    "dependencies": {
        "string-to-stream": "^3.0.1"
    }
}