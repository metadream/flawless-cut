{
    "name": "flawless-cut",
    "productName": "FlawlessCut",
    "version": "1.2.0",
    "description": "Fast, lossless video cutter and merger",
    "author": "Marco Chan",
    "repository": "github:metadream/flawless-cut",
    "copyright": "Copyright (c) 2019-2026",
    "license": "MIT",
    "type": "module",
    "main": "src/main/index.js",
    "scripts": {
        "start": "electron .",
        "build:linux": "electron-builder -l",
        "build:win": "electron-builder -w",
        "build:mac": "electron-builder -m"
    },
    "build": {
        "appId": "flawless-cut",
        "files": [
            "**/*",
            "!bin/**/*"
        ],
        "win": {
            "target": [ "nsis" ],
            "icon": "assets/build/icon.ico",
            "extraResources": [
                { "from": "bin/win32", "to": "bin" }
            ]
        },
        "linux": {
            "target": [ "deb" ],
            "icon": "assets/build/icon.png",
            "extraResources": [
                { "from": "bin/linux", "to": "bin" }
            ]
        },
        "mac": {
            "target": [ "dmg" ],
            "icon": "assets/build/icon.icns",
            "category": "public.app-category.productivity",
            "extraResources": [
                { "from": "bin/darwin", "to": "bin" }
            ],
            "hardenedRuntime": true,
            "entitlements": "assets/build/entitlements.mac.plist",
            "entitlementsInherit": "assets/build/entitlements.mac.plist",
            "extendInfo": {
                "NSMicrophoneUsageDescription": "Please allow access to the microphone",
                "NSDesktopCaptureUsageDescription": "Please allow screen recording"
            }
        }
    },
    "devDependencies": {
        "electron": "^39.2.2",
        "electron-builder": "^26.0.12"
    }
}